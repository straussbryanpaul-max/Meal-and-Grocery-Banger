# Meal & Grocery Banger — Required Credentials
# These are entered by the user in the app's Settings modal (gear icon), not read from this file.
# They are stored in localStorage only — never committed to git.

# JSONBin.io credentials (enables cloud sync of staples + recipes across devices)
# 1. Create a free account at https://jsonbin.io
# 2. Create a new bin with initial content: {"staples":[],"recipes":[],"checkItems":[]}
# 3. Copy the Bin ID and Master Key below
JSONBIN_BIN_ID=...
JSONBIN_MASTER_KEY=$2a$10$...

# Anthropic API key (enables "Auto-fill with AI" in the recipe editor)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
